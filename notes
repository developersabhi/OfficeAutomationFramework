import { envConfig } from './envConfig.js';

export const apiConfig = {
  baseURL: envConfig.apiBaseURL,

  endpoints: {
    posts: '/posts',
    singlePost: '/posts/1',
  },
};


Yahan humne API URL ko central configuration se connect kiya.

Iska benefit: API URL change karne ke liye har test file mein changes nahi karne padte.
